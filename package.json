{
  "name": "tradepulse",
  "version": "2.0.0",
  "description": "Geliştirilmiş Secure Binance Futures Dashboard - TypeScript, Component-Based Frontend, Modüler Backend",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint server/",
    "lint:fix": "eslint server/ --fix",
    "build:client": "vite build client/",
    "dev:client": "vite build client/ --watch",
    "predeploy": "npm run build:client"
  },
  "keywords": [
    "binance",
    "futures",
    "trading",
    "dashboard",
    "security",
    "authentication"
  ],
  "author": "anlhlc",
  "license": "MIT",
  "dependencies": {
    "apicache": "^1.6.3",
    "bcryptjs": "^2.4.3",
    "connect-redis": "^7.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "mongoose": "^8.0.3",
    "redis": "^4.6.12",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
