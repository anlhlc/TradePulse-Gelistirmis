# =====================
# TradePulse Environment Configuration
# Bu dosyayı .env olarak kopyalayın ve değerleri kendinize göre düzenleyin
# =====================

# Sunucu Portu
PORT=3000

# MongoDB Bağlantı String'i
# Seçenek 1: Yerel MongoDB (development için)
# MONGODB_URI=mongodb://localhost:27017/tradepulse

# Seçenek 2: MongoDB Atlas (Cloud - Render.com için bu gerekli!)
# Aşağıdaki formatı kullanın:
# mongodb+srv://<KULLANICI_ADI>:<SIFRE>@cluster0.xxxxx.mongodb.net/tradepulse?retryWrites=true&w=majority
#
# Örnek (kendi bilgilerinizle değiştirin):
# mongodb+srv://admin:TradePulse2024@cluster0.abc123.mongodb.net/tradepulse?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<KULLANICI_ADI>:<SIFRE>@cluster0.xxxxx.mongodb.net/tradepulse?retryWrites=true&w=majority

# Session Gizli Anahtarı (Çok önemli! Bu değeri değiştirin)
# En az 32 karakter uzunluğunda, rastgele ve güçlü bir anahtar kullanın
# Örnek: TradePulseSuperSecretKey2024RandomStringABC123XYZ789
SESSION_SECRET=buraya-çok-güçlü-bir-anahtar-en-az-32-karakter-uzunluğunda-rastgele-string

# Admin Kullanıcı Şifresi (İlk çalıştırmada otomatik oluşturulur)
# Render.com'da bu değeri Environment Variables'dan değiştirin
ADMIN_PASSWORD=BinanceSecure2024!

# Node Environment (production veya development)
NODE_ENV=development
